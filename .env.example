# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Path to Google Service Account JSON key
GOOGLE_CREDENTIALS_PATH=credentials.json

# Google Drive Folder ID where raw PDFs and images will be stored
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# Google Spreadsheet IDs (can be 3 separate spreadsheets, or the same ID with 3 tabs)
BNI_SPREADSHEET_ID=your_bni_spreadsheet_id
BRI_SPREADSHEET_ID=your_bri_spreadsheet_id
ANOMALI_SPREADSHEET_ID=your_anomali_spreadsheet_id

# Worksheet/Tab names inside those spreadsheets
BNI_WORKSHEET_NAME=BNI
BRI_WORKSHEET_NAME=BRI
ANOMALI_WORKSHEET_NAME=ANOMALI

# Optional: Tesseract binary path (needed on Windows, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
